# Copia este archivo como .env.local y rellena los valores (no lo renombres:
# .env.example debe quedarse en el repositorio como plantilla).
# .env.local está ignorado por git: nunca subas tus valores reales.
#
# Todas las variables VITE_* se incluyen en el bundle del navegador.
# Son configuración pública de la app web de Firebase, NO secretos:
# la protección de los datos la dan las Security Rules (firestore.rules).
# Nunca pongas aquí claves privadas, cuentas de servicio ni secretos de terceros.
# Guía paso a paso: docs/FIREBASE.md

# --- Firebase ---
# Firebase Console → Configuración del proyecto → Tus apps → App web → Configuración del SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Desarrollo ---
# true = conecta la app a los emuladores locales (Auth en :9099, Firestore en :8080)
# en lugar del proyecto real. Útil para probar sin crear cuentas reales.
VITE_USE_FIREBASE_EMULATORS=false

# --- Opcional ---
# Si se define, el pie de la landing muestra un enlace de contacto.
VITE_CONTACT_EMAIL=
